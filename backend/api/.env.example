# La API se conecta como casaroca_app: NUNCA como propietario ni superusuario.
# RLS no se aplica al dueño de la tabla, así que conectarse como propietario
# anularía la segunda cerradura sin dar ningún aviso.
PGHOST=/tmp
PGPORT=5433
PGDATABASE=casaroca_dev
PGUSER=casaroca_app
PGPASSWORD=
PORT=3000
# En producción esta llave viene del gestor de llaves (KMS), jamás del entorno.
APP_LLAVE_N4=llave-solo-de-desarrollo
